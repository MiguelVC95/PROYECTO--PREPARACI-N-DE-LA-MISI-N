<mxfile host="app.diagrams.net"><diagram name="Ejercicio 6: Simulación del viaje hacia el destino" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" page="1" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Ejercicio 6: Simulación del viaje hacia el destino" style="text;html=1;align=center;fontStyle=1;fontSize=16;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="-40.0" y="-40" width="900" height="30" as="geometry"/></mxCell><mxCell id="ini" value="Inicio" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400.0" y="0" width="160" height="50" as="geometry"/></mxCell><mxCell id="cons" value="CONSUMO_COMBUSTIBLE_DIA = 8&lt;br&gt;CONSUMO_OXIGENO_TRIPULANTE_DIA = 2&lt;br&gt;CONSUMO_ENERGIA_DIA = 5&lt;br&gt;CONSUMO_PROVISIONES_TRIPULANTE_DIA = 1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290.0" y="90" width="380" height="90" as="geometry"/></mxCell><mxCell id="in" value="Leer dias_viaje, tripulantes, combustible,&lt;br&gt;oxigeno, energia, provisiones" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=20;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290.0" y="220" width="380" height="70" as="geometry"/></mxCell><mxCell id="init" value="dias_transcurridos = 0&lt;br&gt;mision_activa = True&lt;br&gt;consumo_oxigeno_dia = CONSUMO_OXIGENO_TRIPULANTE_DIA × tripulantes&lt;br&gt;consumo_provisiones_dia = CONSUMO_PROVISIONES_TRIPULANTE_DIA × tripulantes" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240.0" y="330" width="480" height="100" as="geometry"/></mxCell><mxCell id="w" value="dias_transcurridos &lt; dias_viaje&lt;br&gt;and mision_activa == True" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300.0" y="520" width="360" height="120" as="geometry"/></mxCell><mxCell id="r" value="combustible &gt;= CONSUMO_COMBUSTIBLE_DIA&lt;br&gt;and oxigeno &gt;= consumo_oxigeno_dia&lt;br&gt;and energia &gt;= CONSUMO_ENERGIA_DIA&lt;br&gt;and provisiones &gt;=&lt;br&gt;consumo_provisiones_dia" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290.0" y="700" width="380" height="170" as="geometry"/></mxCell><mxCell id="mf" value="mision_activa = False" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20.0" y="755" width="200" height="60" as="geometry"/></mxCell><mxCell id="des" value="combustible = combustible − CONSUMO_COMBUSTIBLE_DIA&lt;br&gt;oxigeno = oxigeno − consumo_oxigeno_dia&lt;br&gt;energia = energia − CONSUMO_ENERGIA_DIA&lt;br&gt;provisiones = provisiones − consumo_provisiones_dia" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="260.0" y="920" width="440" height="110" as="geometry"/></mxCell><mxCell id="inc" value="dias_transcurridos = dias_transcurridos + 1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290.0" y="1070" width="380" height="50" as="geometry"/></mxCell><mxCell id="dia" value="Mostrar &quot;Día&quot;, dias_transcurridos, combustible,&lt;br&gt;oxigeno, energia, provisiones" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=20;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270.0" y="1160" width="420" height="70" as="geometry"/></mxCell><mxCell id="df" value="dias_transcurridos ==&lt;br&gt;dias_viaje" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330.0" y="1330" width="300" height="100" as="geometry"/></mxCell><mxCell id="ok" value="Mostrar &quot;La nave llegó al destino en&quot;,&lt;br&gt;dias_transcurridos, &quot;días.&quot; y los recursos&lt;br&gt;restantes: combustible, oxigeno,&lt;br&gt;energia, provisiones" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=20;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280.0" y="1480" width="400" height="100" as="geometry"/></mxCell><mxCell id="fa" value="dia_fallo = dias_transcurridos + 1" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770.0" y="1350" width="260" height="60" as="geometry"/></mxCell><mxCell id="vi" value="Mostrar &quot;Viaje interrumpido en el día&quot;,&lt;br&gt;dia_fallo" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=20;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750.0" y="1450" width="300" height="60" as="geometry"/></mxCell><mxCell id="dc" value="combustible &lt; CONSUMO_COMBUSTIBLE_DIA" style="rhombus;whiteSpace=wrap;html